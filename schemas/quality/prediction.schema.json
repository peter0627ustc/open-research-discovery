{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Problem-quality benchmark prediction",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "citation_accuracy",
    "openness_argument",
    "scope_fidelity",
    "verification_executability",
    "evidence_relevance",
    "overall"
  ],
  "$defs": {
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "severity", "detail"],
      "properties": {
        "type": {"type": "string", "minLength": 1},
        "severity": {"enum": ["minor", "major", "critical"]},
        "detail": {"type": "string", "minLength": 1}
      }
    }
  },
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "case_id": {
      "type": "string",
      "pattern": "^(ORP|OMP)-[0-9]{4,}$|^CAN-[A-F0-9]{12}$"
    },
    "citation_accuracy": {
      "description": "Cited works exist and are paraphrased accurately when cross-checked against frozen_evidence.",
      "type": "object",
      "additionalProperties": false,
      "required": ["score", "issues", "rationale"],
      "properties": {
        "score": {"type": "integer", "minimum": 0, "maximum": 3},
        "issues": {"type": "array", "items": {"$ref": "#/$defs/issue"}},
        "rationale": {"type": "string"}
      }
    },
    "openness_argument": {
      "description": "The openness argument holds and the surviving open core is genuinely supported by the cited audit evidence.",
      "type": "object",
      "additionalProperties": false,
      "required": ["score", "issues", "rationale"],
      "properties": {
        "score": {"type": "integer", "minimum": 0, "maximum": 3},
        "issues": {"type": "array", "items": {"$ref": "#/$defs/issue"}},
        "rationale": {"type": "string"}
      }
    },
    "scope_fidelity": {
      "description": "Statement precision and problem-window quality: source-faithful, one closed resolution claim for a leaf record, and honest labeling of derived or partial targets. For Schema 1.0, judge the semantic statement rather than penalizing absence of the explicit 1.1 metadata fields.",
      "type": "object",
      "additionalProperties": false,
      "required": ["score", "issues", "rationale"],
      "properties": {
        "score": {"type": "integer", "minimum": 0, "maximum": 3},
        "issues": {"type": "array", "items": {"$ref": "#/$defs/issue"}},
        "rationale": {"type": "string"}
      }
    },
    "verification_executability": {
      "description": "A qualified domain expert can determine whether the submitted evidence fully resolves the stated claim. AI/CI execution, fixed numerical thresholds, and low reviewer workload are not required; semantic loopholes and quantifier mismatches remain defects.",
      "type": "object",
      "additionalProperties": false,
      "required": ["score", "issues", "rationale"],
      "properties": {
        "score": {"type": "integer", "minimum": 0, "maximum": 3},
        "issues": {"type": "array", "items": {"$ref": "#/$defs/issue"}},
        "rationale": {"type": "string"}
      }
    },
    "evidence_relevance": {
      "description": "Evidence Direct/Adjacent framing is appropriate: each item genuinely bears on this problem's status or formulation.",
      "type": "object",
      "additionalProperties": false,
      "required": ["score", "issues", "rationale"],
      "properties": {
        "score": {"type": "integer", "minimum": 0, "maximum": 3},
        "issues": {"type": "array", "items": {"$ref": "#/$defs/issue"}},
        "rationale": {"type": "string"}
      }
    },
    "overall": {
      "type": "object",
      "additionalProperties": false,
      "required": ["grade", "rationale"],
      "properties": {
        "grade": {
          "description": "A = publishable as-is (no major issues); B = sound with minor revisions needed; C = major defects that must be fixed before the repository is trustworthy.",
          "enum": ["A", "B", "C"]
        },
        "rationale": {"type": "string"}
      }
    }
  }
}
