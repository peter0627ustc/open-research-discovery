{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Open research discovery campaign",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "name", "topics", "limits", "agents", "outputs"],
  "allOf": [
    {
      "if": {"required": ["mode"], "properties": {"mode": {"const": "author_literature"}}},
      "then": {"required": ["authors"], "properties": {"limits": {"not": {"required": ["questions_per_domain"]}}}},
      "else": {"properties": {"limits": {"required": ["questions_per_domain"]}}}
    }
  ],
  "properties": {
    "mode": {"enum": ["topic", "author_literature"], "default": "topic"},
    "input_issues": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["literature_id", "author_ids", "doi", "reason"],
        "properties": {
          "literature_id": {"type": "string"}, "doi": {"type": "string"},
          "reason": {"type": "string"},
          "author_ids": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "authors": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "name"],
        "properties": {"id": {"type": "string", "minLength": 1}, "name": {"type": "string", "minLength": 1}}
      }
    },
    "schema_version": {"const": 2},
    "name": {"type": "string", "minLength": 1},
    "topics": {
      "description": "One or more user topics. Each accepted problem compiles into its own solution repository and retains topic_id for grouping.",
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/topic"}
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lkm_timeout_seconds"
      ],
      "properties": {
        "questions_per_domain": {"description": "Maximum candidate questions Discovery selects per topic; defaults to 20 in campaign init.", "type": "integer", "minimum": 1, "maximum": 1000},
        "lkm_timeout_seconds": {"type": "number", "minimum": 1, "maximum": 600}
      }
    },
    "agents": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "timeout_seconds"],
      "allOf": [
        {
          "if": {
            "required": ["backend"],
            "properties": {"backend": {"enum": ["kimi", "claude", "trae"]}}
          },
          "else": {
            "required": ["codex_executable", "sandbox"],
            "comment": "codex_executable and sandbox are only required for the default codex backend; the kimi, claude, and trae backends read neither."
          }
        }
      ],
      "properties": {
        "model": {"type": "string"},
        "backend": {
          "description": "Headless agent backend. 'codex' uses codex exec with API-enforced or prompt-validated JSON-Schema output and OS sandbox isolation. 'kimi' and 'claude' use their prompt CLIs. 'trae' supports both internal traecli exec and open-source trae-cli run through a file-delivery contract with post-hoc schema validation. Defaults to 'codex'.",
          "enum": ["codex", "kimi", "claude", "trae"],
          "default": "codex"
        },
        "kimi_executable": {
          "description": "Kimi Code CLI executable used when backend is 'kimi'. Defaults to 'kimi'.",
          "type": "string",
          "minLength": 1,
          "default": "kimi"
        },
        "claude_executable": {
          "description": "Claude Code CLI executable used when backend is 'claude'. Defaults to 'claude'.",
          "type": "string",
          "minLength": 1,
          "default": "claude"
        },
        "trae_executable": {
          "description": "Trae CLI executable used when backend is 'trae'. Defaults to 'trae-cli'.",
          "type": "string",
          "minLength": 1,
          "default": "trae-cli"
        },
        "trae_config_file": {
          "description": "Optional Trae CLI configuration file.",
          "type": "string",
          "default": ""
        },
        "codex_executable": {"type": "string", "minLength": 1},
        "codex_structured_output_mode": {
          "description": "Codex output contract mode. 'api' passes --output-schema to the Responses API. 'prompt' carries the schema in the prompt and validates the returned JSON locally for providers that do not support API structured output.",
          "enum": ["api", "prompt"],
          "default": "api"
        },
        "sandbox": {"enum": ["read-only", "workspace-write"]},
        "networked_sandbox": {"enum": ["read-only", "workspace-write"]},
        "network_access": {"type": "boolean"},
        "workers": {
          "description": "Maximum concurrent networked Agent calls across the campaign; defaults to 32.",
          "type": "integer",
          "minimum": 1,
          "maximum": 128,
          "default": 32
        },
        "topic_workers": {
          "description": "Maximum concurrently active topic pipelines. Defaults to agents.workers.",
          "type": "integer",
          "minimum": 1,
          "maximum": 128
        },
        "candidate_workers_per_topic": {
          "description": "Maximum candidate Research-to-Review chains run concurrently within one streaming topic. Defaults to 1.",
          "type": "integer",
          "minimum": 1,
          "maximum": 128,
          "default": 1
        },
        "retries": {
          "description": "Retries after an invocation failure; contract failures are not retried. Defaults to 1.",
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "retry_backoff_seconds": {
          "description": "Base seconds for exponential retry backoff. Defaults to 5.",
          "type": "number",
          "minimum": 0
        },
        "timeout_seconds": {"type": "integer", "minimum": 60, "maximum": 14400}
      }
    },
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runs_root", "problem_root", "pool_root"],
      "properties": {
        "runs_root": {"type": "string", "minLength": 1},
        "problem_root": {
          "description": "Backward-compatible field name for the directory that receives one solution repository per accepted problem.",
          "type": "string",
          "minLength": 1
        },
        "pool_root": {"type": "string"}
      }
    }
  },
  "$defs": {
    "paper": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paper_id", "doi", "title"],
      "properties": {
        "paper_id": {"type": "string"},
        "doi": {"type": "string"},
        "title": {"type": "string"}
      }
    },
    "reference": {      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "title", "identifier", "url", "locator", "excerpt"],
      "properties": {
        "kind": {"enum": ["book", "paper", "web", "dataset", "user_reference"]},
        "title": {"type": "string", "minLength": 1},
        "identifier": {"type": "string"},
        "url": {"type": "string"},
        "locator": {"type": "string"},
        "excerpt": {"type": "string"}
      }
    },
    "topic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "query",
        "sources",
        "seed_papers",
        "seed_references"
      ],
      "properties": {
        "author_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "domain": {"type": "string", "minLength": 1},
        "literature_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
        "title": {"type": "string", "minLength": 1},
        "query": {"type": "string", "minLength": 1},
        "sources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["lkm_open_questions", "topic_search"]}
        },
        "seed_papers": {"type": "array", "items": {"$ref": "#/$defs/paper"}},
        "seed_references": {"type": "array", "items": {"$ref": "#/$defs/reference"}}
      }
    }
  }
}
